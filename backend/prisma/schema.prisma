
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model Motorista { id Int @id @default(autoincrement()) nome String }
model Veiculo { id Int @id @default(autoincrement()) placa String }
model Abastecimento { id Int @id @default(autoincrement()) litros Float }
